# MatchRV environment — ALL variables are OPTIONAL for the WebMCP demo.
# A fresh clone runs with none of these set: `pnpm install && pnpm dev`
# boots the API with an embedded PGlite database (auto-seeded from the
# committed inventory snapshot) and the web app on http://localhost:5173.
# Never commit real values.

# ── Core (optional) ─────────────────────────────────────────────────────────
# PostgreSQL connection. Unset → embedded PGlite is used instead.
#DATABASE_URL=postgres://user:pass@host:5432/matchrv

# API server port (dev default: 8080). The web dev server proxies /api here.
#PORT=8080

# Where the embedded database stores its files (default: lib/db/.data/pglite,
# gitignored). Point at a writable dir on read-only hosts.
#PGLITE_DATA_DIR=/tmp/matchrv-pglite

# Web build base path (default "/"). Only needed for subpath deployments.
#BASE_PATH=/

# ── Legacy AI Outfitter chat + enrichment (optional; unrelated to WebMCP) ──
#AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
#AI_INTEGRATIONS_ANTHROPIC_API_KEY=

# ── Legacy account features via Clerk (optional) ───────────────────────────
#CLERK_PUBLISHABLE_KEY=
#CLERK_SECRET_KEY=
#VITE_CLERK_PUBLISHABLE_KEY=

# ── Legacy /browse city-autocomplete via Google Places (optional) ──────────
# Without it the search box is a plain text input. The WebMCP demo does not
# use Google services at all.
#VITE_GOOGLE_PLACES_API_KEY=

# ── Legacy admin/ops (optional) ────────────────────────────────────────────
#ADMIN_KEY=
#IMPORT_API_KEY=
