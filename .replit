modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "RV Inventory Scraper (Daily 3AM)"

[[workflows.workflow]]
name = "RV Inventory Scraper (Daily 3AM)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m rv_inventory_scraper.scheduler"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["sendgrid:1.0.0", "twilio:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gitFull", "glibcLocales", "orbiton", "playwright-driver", "postgresql", "unzip", "zip"]

[userenv]

