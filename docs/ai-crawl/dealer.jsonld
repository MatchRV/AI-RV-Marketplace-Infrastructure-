{
  "@context": "https://schema.org",
  "@type": ["AutoDealer", "LocalBusiness"],
  "@id": "https://matchrv.com/dealers/{{dealer.id}}#dealer",
  "name": "{{dealer.name}}",
  "url": "https://matchrv.com/dealers/{{dealer.id}}",
  "sameAs": ["{{dealer.website}}"],
  "telephone": "{{dealers.phone | only if present}}",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "{{dealer.city}}",
    "addressRegion": "{{dealer.state}}",
    "addressCountry": "US"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": "{{dealer.lat}}", "longitude": "{{dealer.lng}}" },
  "parentOrganization": { "@type": "Organization", "name": "{{dealer group name | only if known}}" },
  "makesOffer": {
    "@type": "AggregateOffer",
    "offerCount": "{{count of this dealer's available units on MatchRV}}",
    "priceCurrency": "USD",
    "lowPrice": "{{min priceUsd.value of available units}}",
    "highPrice": "{{max priceUsd.value of available units}}"
  },
  "subjectOf": {
    "@type": "ItemList",
    "name": "{{dealer.name}} RV inventory on MatchRV",
    "numberOfItems": "{{count of available units}}",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "url": "https://matchrv.com/listing/{{unit.id}}" }
    ]
  }
}
