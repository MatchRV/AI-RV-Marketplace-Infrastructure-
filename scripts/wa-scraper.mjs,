async function main() {
console.log("🚐 MatchRV WA Scraper — Running on Replit\n");
const state = loadState();
const pending = WA_DEALERS.filter(d=>!state.completed.includes(d.name));
console.log(`📋 ${pending.length} dealers pending\n`);
const stats = {ok:0,failed:0,units_found:0,units_pushed:0,skipped:0};

for (const dealer of pending) {
const units = await scrapeDealer(dealer);
if (units===null) {
state.failed.push({name:dealer.name,at:new Date().toISOString()});
stats.failed++; saveState(state); continue;
}
stats.units_found+=units.length;
let pushed=0,skipped=0;
for (const unit of units) {
const r = await pushListing(unit,dealer);
if (r?.id) { pushed++; console.log(` ${r.created?"✅":"🔄"} [${r.id}] ${unit.year} ${unit.make} ${unit.model}`); }
else skipped++;
await sleep(150);
}
stats.units_pushed+=pushed; stats.skipped+=skipped; stats.ok++;
state.completed.push(dealer.name); saveState(state);
console.log(` ✅ ${dealer.name}: ${pushed} pushed, ${skipped} skipped\n`);
await sleep(5000);
}

state.lastRun={...stats,at:new Date().toISOString()}; saveState(state);
console.log("═".repeat(50));
console.log(`📊 DONE — ${stats.units_pushed} units pushed across ${stats.ok} dealers`);
console.log("═".repeat(50));
}

main().catch(console.error);


Once the file is saved, run in Replit shell:
bash
node scripts/wa-scraper.mjs